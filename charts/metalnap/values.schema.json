{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "metalnap values",
  "type": "object",
  "required": ["nodes", "mode", "bmc"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Nodes metalnap may manage. It touches nothing else."
    },
    "mode": {
      "type": "string",
      "enum": ["off", "dry_run", "on"],
      "description": "Quote it. Unquoted on/off are YAML booleans and will fail."
    },
    "bmc": {
      "type": "object",
      "required": ["hostFormat", "existingSecret"],
      "properties": {
        "hostFormat": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string", "minLength": 1}
      }
    },
    "prometheus": {"type": "object", "properties": {"url": {"type": "string"}}},
    "alertmanager": {"type": "object", "properties": {"url": {"type": "string"}}},
    "warmup": {
      "type": "object",
      "properties": {
        "image": {"type": "string"},
        "pullSecrets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cordonAnnotation": {"type": "string", "minLength": 1},
    "burstTaintKey": {"type": "string"},
    "tolerations": {
      "type": "array",
      "description": "Keep this empty. metalnap must never be schedulable onto a node it manages."
    },
    "timers": {
      "type": "object",
      "properties": {
        "intervalS": {"type": "integer", "minimum": 10},
        "wakeSustainS": {"type": "integer", "minimum": 0},
        "sleepSustainS": {"type": "integer", "minimum": 0},
        "minUptimeS": {"type": "integer", "minimum": 0},
        "wakeTimeoutS": {"type": "integer", "minimum": 60},
        "drainTimeoutS": {"type": "integer", "minimum": 60},
        "warmupTimeoutS": {"type": "integer", "minimum": 0},
        "maxSleepAttempts": {"type": "integer", "minimum": 1},
        "sleepCooldownS": {"type": "integer", "minimum": 0},
        "defaultCapacityGib": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
